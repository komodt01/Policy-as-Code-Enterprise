{
"Version": "2012-10-17",
"Statement": [
{
"Sid": "RestrictHighCostEC2InstanceTypes",
"Effect": "Deny",
"Action": "ec2:RunInstances",
"Resource": "arn:aws:ec2:*:*:instance/*",
"Condition": {
"StringEquals": {
"ec2:InstanceType": [
"p3.24xlarge",
"p4d.24xlarge",
"x1e.32xlarge",
"z1d.12xlarge",
"r5.24xlarge",
"m5.24xlarge",
"c5.24xlarge"
]
},
"StringNotEquals": {
"aws:RequestTag/CostApproval": "Approved"
}
}
},
{
"Sid": "RequireCostCenterForEC2Launch",
"Effect": "Deny",
"Action": "ec2:RunInstances",
"Resource": "arn:aws:ec2:*:*:instance/*",
"Condition": {
"Null": {
"aws:RequestTag/CostCenter": "true"
}
}
},
{
"Sid": "RequireProjectForEC2Launch",
"Effect": "Deny",
"Action": "ec2:RunInstances",
"Resource": "arn:aws:ec2:*:*:instance/*",
"Condition": {
"Null": {
"aws:RequestTag/Project": "true"
}
}
},
{
"Sid": "RequireEnvironmentForEC2Launch",
"Effect": "Deny",
"Action": "ec2:RunInstances",
"Resource": "arn:aws:ec2:*:*:instance/*",
"Condition": {
"Null": {
"aws:RequestTag/Environment": "true"
}
}
},
{
"Sid": "RestrictHighCostRegions",
"Effect": "Deny",
"Action": [
"ec2:RunInstances",
"rds:CreateDBInstance"
],
"Resource": "*",
"Condition": {
"StringEquals": {
"aws:RequestedRegion": [
"ap-northeast-1",
"eu-central-1",
"sa-east-1"
]
}
}
},
{
"Sid": "RestrictLargeEBSVolumes",
"Effect": "Deny",
"Action": "ec2:CreateVolume",
"Resource": "*",
"Condition": {
"NumericGreaterThan": {
"ec2:VolumeSize": "1000"
},
"StringNotEquals": {
"aws:RequestTag/StorageApproval": "Approved"
}
}
}
]
}
